generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  MARKETPLACE
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  role        Role         @default(STAFF)
  purchases   Purchase[]
  sales       Sale[]
  expenses    Expense[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  sku         String       @unique
  unit        String       @default("pcs")
  sellPrice   Decimal      @db.Decimal(14, 2)
  stock       Int          @default(0)
  minStock    Int          @default(5)
  isActive    Boolean      @default(true)
  saleItems   SaleItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Purchase {
  id          Int            @id @default(autoincrement())
  date        DateTime       @default(now())
  itemName    String
  totalAmount Decimal        @db.Decimal(14, 2)
  createdById Int
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([date])
}

model Sale {
  id              Int            @id @default(autoincrement())
  date            DateTime       @default(now())
  channel         String         @default("OFFLINE")
  paymentMethod   PaymentMethod  @default(CASH)
  description     String?
  totalAmount     Decimal        @db.Decimal(14, 2)
  createdById     Int
  createdBy       User           @relation(fields: [createdById], references: [id])
  items           SaleItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([date])
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int
  productId  Int
  quantity   Int
  unitPrice  Decimal  @db.Decimal(14, 2)
  totalPrice Decimal  @db.Decimal(14, 2)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  date        DateTime        @default(now())
  description String
  amount      Decimal         @db.Decimal(14, 2)
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
}

model DailySummary {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  totalCapital     Decimal  @db.Decimal(14, 2)
  totalSales       Decimal  @db.Decimal(14, 2)
  totalExpenses    Decimal  @db.Decimal(14, 2)
  endingBalance    Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}